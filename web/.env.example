# Dedicated staging database for the new Next.js app.
# Do not point this at the current Railway production database while the migration is in progress.
DATABASE_URL="postgresql://user:password@host:5432/yellow_airline_web_staging?schema=public"

# New secret for cookie-based sessions in web/.
JWT_SECRET="replace-with-a-long-random-secret-for-web"

# Public URL used by Stripe success/cancel URLs in the new app.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe test keys for the new staging environment.
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
