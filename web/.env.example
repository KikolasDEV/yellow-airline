# Dedicated resources. Never copy production credentials into Preview.
APP_ENV="development"
APP_URL="http://localhost:3000"
DATABASE_URL="postgresql://user:password@host:5432/yellow_airline_development?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/yellow_airline_development?schema=public"
JWT_SECRET="replace-with-at-least-32-random-characters"
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Fail closed: enable deliberately only after migrations and webhook validation.
WRITES_ENABLED="false"
PAYMENTS_ENABLED="false"
SETTLEMENTS_ENABLED="false"
CRON_SECRET="replace-with-a-different-random-secret-at-least-32-characters"

# Optional. Only provision a demonstration account in an isolated non-production DB.
ALLOW_DEMO_SEED="false"
# DEMO_USER_PASSWORD=""
# Only for an explicitly approved migration, not required during builds:
# MIGRATION_APPROVED="true"
# MIGRATION_BACKUP_CONFIRMED="true"
