// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  passport  String
  password  String
  isVip     Boolean  @default(true) // Todos tus usuarios actuales serán VIP
  createdAt DateTime @default(now())
  bookings  Booking[]
  checkoutOrders CheckoutOrder[]
}

model Flight {
  id            Int       @id @default(autoincrement())
  origin        String
  destination   String
  departureTime DateTime
  price         Float
  capacity      Int       @default(180) // Capacidad estándar A320
  bookings      Booking[]
  checkoutOrders CheckoutOrder[]
  seats         FlightSeat[]
}

model Booking {
  id              Int      @id @default(autoincrement())
  user            User     @relation(fields: [userId], references: [id])
  userId          Int
  flight          Flight   @relation(fields: [flightId], references: [id])
  flightId        Int
  
  // Desglose de pasajeros
  adults          Int      @default(1)
  children        Int      @default(0)
  infants         Int      @default(0)
  basePrice       Float    @default(0)
  finalPrice      Float    @default(0)
  currency        String   @default("eur")
  status          String   @default("PENDING")
  bookingReference String  @unique @default(cuid())
  stripeSessionId String?  @unique
  seatNumber      String?
  gate            String?
  boardingGroup   String?
  selectedSeats   String[] @default([])
  totalAmount     Int?
  checkoutOrder   CheckoutOrder?
  createdAt       DateTime @default(now())

  // Evitamos que un usuario reserve el mismo vuelo dos veces
  @@unique([userId, flightId]) 
}

// Additive tables: legacy Booking records and their prices remain unchanged.
model CheckoutOrder {
  id              String   @id @default(uuid())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  flightId        Int
  flight          Flight   @relation(fields: [flightId], references: [id])
  bookingId       Int?     @unique
  booking         Booking? @relation(fields: [bookingId], references: [id])
  status          String   @default("CREATING")
  stripeSessionId String?  @unique
  adults          Int
  children        Int
  infants         Int
  selectedSeats   String[]
  basePrice       Float
  unitAmount      Int
  seatAmount      Int
  amountTotal     Int
  currency        String   @default("eur")
  appUrl          String
  environment     String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  seats           FlightSeat[]

  @@index([flightId, status])
  @@index([userId, flightId, status])
}

model FlightSeat {
  flightId Int
  flight   Flight        @relation(fields: [flightId], references: [id])
  number   String
  orderId  String
  order    CheckoutOrder @relation(fields: [orderId], references: [id])

  @@id([flightId, number])
  @@index([orderId])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}
