{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "postinstall": "prisma generate",
    "check:staging-env": "node ./scripts/check-staging-env.mjs",
    "check:env": "node ./scripts/check-env.mjs",
    "payments:reconcile": "tsx ./scripts/reconcile-payments.ts",
    "db:verify": "tsx ./scripts/verify-database.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "node ./scripts/migrate-deploy.mjs",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "framer-motion": "^12.38.0",
    "i18next": "^26.0.3",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "next": "16.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "stripe": "^18.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "dotenv": "^17.3.1",
    "eslint-config-next": "16.4.6",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
